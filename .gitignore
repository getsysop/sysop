# Sysop runtime dir (Phase 133 consolidation). install.sh seeds exactly this
# line for consumers; this repo never had it, so a claim_task.sh --lock run here
# left a real lock TRACKABLE -- and Phase 171 shipped a leak that way: a
# reconciliation sub-agent's lock carried an absolute home path into a commit,
# turning the mirror-leak gate red. Locks resolve to the MAIN repo root by
# design (Phase 32), so any worktree's claim lands here.
sysop/runtime/
# Workflow runtime directories (created on demand by skills/scripts)
.locks/
.pending-docs/
.auto-build/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Build / dist (when installers exist)
/dist/
/build/

# Local install state (tracked in target projects, not in this repo)
.workflow-version
.workflow-packs

# Local Claude Code state (per-machine, not workflow content)
# (settings.local.json is covered by the user's global git ignore)
.claude/settings.json

# Scratch attach-copy of docs/workflow.html — must never ship in the public mirror
workflow_2.html
