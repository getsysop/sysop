# Sysop close gate relay — re-runs the gate when a review arrives (spec § 10.3 item 4).
#
# UNARMED. Ships as `.example`; arm it with `sysop-close-gate.yml.example`, whose header lists the
# setup. `pull_request_target` has no review type, and a `pull_request_review` run is in the
# context of the pull request's merge ref, which the gate's environment refuses. So this
# workflow does nothing but finish, and the gate listens for its completion (`workflow_run`,
# which runs on the default branch) and re-evaluates the open pull requests at that head. It
# carries nothing to the gate: who triggered it does not matter, because the gate reads
# GitHub's state, not the trigger.

name: sysop close gate relay

on:
  pull_request_review:
    types: [submitted, edited, dismissed]
  pull_request_review_comment:
    types: [created, edited, deleted]

permissions: {}

jobs:
  relay:
    runs-on: ubuntu-24.04
    timeout-minutes: 2
    steps:
      - run: echo "relayed to the sysop close gate"
