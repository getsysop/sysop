#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# pre-commit fragment — validate tasks/index.yml on touch
#
# Drop-in block to add to your project's pre-commit hook. Runs
# sysop/scripts/validate_tasks.py only when the staged diff touches
# tasks/ or sysop/runtime/locks/, so non-tasks commits pay no cost.
#
# Python resolution order (Phase 16 carryover from gdp@abcfe3d0):
#   1. <main-repo-root>/.venv/bin/python3
#      Resolved via `git rev-parse --git-common-dir`, so a worktree
#      inherits the main repo's venv automatically (worktrees have
#      their own .git file pointing at the main .git/).
#   2. System python3 as a fallback. Since Sysop Phase 182 the
#      validator resolves venv PyYAML itself (script-anchored
#      first, then the main checkout via git-common-dir, across
#      both .venv/ and venv/ layouts), so this arm succeeds
#      wherever a venv exists. It fails — loudly, exit 2, naming
#      the fix — only when no interpreter reachable from here
#      can import yaml at all.
#
# Without this resolution, every developer who hadn't activated
# .venv before `git commit` would hit:
#     ModuleNotFoundError: No module named 'yaml'
# which the original gdp pre-commit hit on the first non-activated
# fresh shell after Phase 16 landed there.
#
# Wiring:
#   1. Copy this block into your existing pre-commit hook (e.g.,
#      next to the BLOCKING checks in pre-commit-python.example).
#   2. Ensure pyyaml is in your dev dependencies (`pyyaml >= 6`).
#   3. Smoke-test by staging a tasks/ change and running
#      `git commit --dry-run`.
# ──────────────────────────────────────────────────────────────

# ── B6. tasks/ validator (Phase 16) ──────────────────────────
# Resolves <main-repo-root>/.venv/bin/python3 via git-common-dir
# (so worktrees inherit the main repo's venv), then falls back to
# system python3.
STAGED_TASKS=$(echo "$STAGED" | grep -E '^(tasks/|sysop/runtime/locks/)' || true)
if [[ -n "$STAGED_TASKS" ]]; then
  # Resolve the main repo's git dir (worktrees: .git/worktrees/<name>/
  # has a commondir file pointing back at the main .git/).
  GIT_COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null || true)
  MAIN_REPO_ROOT=""
  if [[ -n "$GIT_COMMON_DIR" ]]; then
    # git-common-dir returns a path relative to PWD for the main repo,
    # or absolute for worktrees. Canonicalize either case.
    if [[ "$GIT_COMMON_DIR" = /* ]]; then
      MAIN_REPO_ROOT="$(dirname "$GIT_COMMON_DIR")"
    else
      MAIN_REPO_ROOT="$(dirname "$(CDPATH= cd "$GIT_COMMON_DIR" && pwd)")"
    fi
  fi

  PYTHON3=""
  if [[ -n "$MAIN_REPO_ROOT" ]] && [[ -x "$MAIN_REPO_ROOT/.venv/bin/python3" ]]; then
    PYTHON3="$MAIN_REPO_ROOT/.venv/bin/python3"
  elif command -v python3 >/dev/null 2>&1; then
    PYTHON3="$(command -v python3)"
  fi

  if [[ -z "$PYTHON3" ]]; then
    block "tasks/: no python3 found (need <main-repo-root>/.venv/bin/python3 or system python3)"
  elif [[ ! -f sysop/scripts/validate_tasks.py ]]; then
    block "tasks/: sysop/scripts/validate_tasks.py missing (re-run install.sh?)"
  else
    # Validate the STAGED tasks/ tree, not the working tree (Sysop Phase 222,
    # Q-020). The default path reads the filesystem, so this block used to say
    # "rejected the staged tree" about a validator that never saw it: stage a
    # bad index.yml, fix the disk copy without re-staging, and the hook passed
    # while the commit carried the violation. `git checkout-index` exports the
    # index's tasks/ files; `--path` (the flag built for exactly this) points
    # the validator at the export. Lock state is runtime (gitignored, never in
    # the index), and under `--path` the validator's locks-dir resolution
    # falls back BESIDE the export (its /tmp dir is not a git repo — Phase
    # 222's round proved the "resolves via git itself" assumption false by
    # execution: every staged in_progress task read lock-missing). So the
    # REAL locks are copied in next to the exported tasks/ — from the main
    # repo root, which is where Phase 32 puts them whichever worktree this
    # hook runs in.
    STAGED_TASKS_EXPORT=$(mktemp -d "${TMPDIR:-/tmp}/sysop-staged-tasks.XXXXXX")
    git ls-files -z -- tasks/ | git checkout-index --prefix="$STAGED_TASKS_EXPORT/" -z --stdin
    if [[ -n "$MAIN_REPO_ROOT" ]] && [[ -d "$MAIN_REPO_ROOT/sysop/runtime/locks" ]]; then
      mkdir -p "$STAGED_TASKS_EXPORT/sysop/runtime"
      cp -R "$MAIN_REPO_ROOT/sysop/runtime/locks" "$STAGED_TASKS_EXPORT/sysop/runtime/"
    fi
    if ! "$PYTHON3" sysop/scripts/validate_tasks.py --quiet --path "$STAGED_TASKS_EXPORT/tasks"; then
      block "tasks/: validate_tasks.py rejected the staged tree (see above)"
    fi
    rm -rf "$STAGED_TASKS_EXPORT"
  fi
fi
