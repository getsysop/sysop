#!/bin/bash
# Pre-commit hook: two-tier convention checks
# Blocking checks (B1-BN): reject commit on match
# Advisory checks (A1-AN): warn but allow commit
#
# Escape hatch: PRE_COMMIT_ADVISORY_ONLY=1 git commit ...
#
# This is a skeleton. Each project populates its own B*/A* checks
# based on the conventions in CLAUDE.md and convention_map.md.
# See git-hooks/examples/pre-commit-python.example in the Sysop source
# repo (not installed into consumer trees) for a worked example
# (Python web service: 5 blocking + 9 advisory checks).

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED_FILES" ] && exit 0

# Separate by file type — adjust filters for your project's languages
STAGED_PY=$(echo "$STAGED_FILES" | grep '\.py$' || true)
STAGED_TS=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx)$' || true)
STAGED_TESTS=$(echo "$STAGED_FILES" | grep -E '(__tests__|tests/)' || true)

BLOCKING_FAILED=0
ADVISORY_NOTES=""

# === BLOCKING CHECKS ===
#
# Grep the INDEX (`git grep --cached`), never the working tree (Sysop Phase 222,
# Q-020). The file list above comes from `git diff --cached`, so a working-tree
# grep checks different content than the commit will carry: stage a violating
# blob, clean the working tree without re-staging, and a working-tree grep
# passes while `git show :<file>` (the index) holds the violation (reproduced).
# Each filename is passed as a QUOTED `:(literal)` pathspec: unquoted, bash
# glob-expands a name like `d[1].py` against the working tree before git ever
# sees it, and unmagicked, git glob-matches the pathspec against other index
# files — both reproduced, both directions of checking the wrong file.

